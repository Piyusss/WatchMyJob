{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:notification-worker": "tsx watch src/notificationWorker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "start:notification-worker": "node dist/notificationWorker.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "admin:companies": "tsx src/admin/companies.ts",
    "admin:sources": "tsx src/admin/sources.ts",
    "admin:sync": "tsx src/admin/sync.ts",
    "admin:initial-sync": "tsx src/admin/initialSync.ts",
    "admin:health": "tsx src/admin/health.ts",
    "admin:reclassify": "tsx src/admin/reclassify.ts",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1126.0",
    "@clerk/backend": "^2.33.6",
    "@clerk/fastify": "^2.6.34",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/client": "^5.19.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.1",
    "pino": "^10.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "prisma": "^5.19.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
