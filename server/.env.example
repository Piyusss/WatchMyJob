DATABASE_URL="postgresql://jobdrop:jobdrop@localhost:5433/jobdrop"
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# Clerk (see auth/authenticate.ts) -- required, the API refuses to boot
# without both. Same application as web/.env.local.example's
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY; get both from the Clerk dashboard's
# API Keys page.
CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Email provider precedence (see src/email/index.ts):
#   Brevo (both vars set) > Resend (both vars set) > SES (SES_FROM_EMAIL set)
#   > console provider.
# With none set, emails are printed to the log instead of sent -- which is
# the intended default for local development.

# Brevo: free tier, no card, no domain needed -- verifies a single sender
# address instead. Get the API key from Brevo -> Settings -> SMTP & API,
# and verify BREVO_FROM_EMAIL under Senders, Domains & Dedicated IPs.
BREVO_API_KEY=""
BREVO_FROM_EMAIL=""
BREVO_FROM_NAME="JobDrop"

# Resend: free tier, no card, but only delivers to arbitrary recipients once
# you verify an owned domain. RESEND_FROM_EMAIL accepts a display name, e.g.
# "JobDrop <alerts@you.com>", or "JobDrop <onboarding@resend.dev>" for
# testing without a domain (delivers only to your own signup address).
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# AWS SES: alternative to Resend. Credentials come from the standard AWS SDK
# chain (env vars / shared config / instance role), not from here.
SES_FROM_EMAIL=""
SES_REGION="us-east-1"

# Shared secret required on the SES/SNS delivery-feedback webhook
# (?token=...). Optional -- only meaningful once a real SNS subscription
# exists to call it.
SES_WEBHOOK_SECRET=""
