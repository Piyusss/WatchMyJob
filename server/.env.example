# Copy to server/.env for local development: `npm run dev:server` loads it.
# Variables already set in your shell take precedence over this file.

# DynamoDB. The server creates its table on first start (see
# internal/store/table.go), sized for AWS's free tier.
#
# Locally: DynamoDB Local in Docker (`npm run db:up`), at the endpoint
# below. It takes any AWS keys, so none are needed.
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE=jobdrop
#
# On AWS: leave DYNAMODB_ENDPOINT out, and set the table's region (the one
# closest to the server) and the keys of an IAM user allowed to use the
# table. The AWS SDK reads the keys itself.
# AWS_REGION=us-west-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

PORT=4000
# Where Prometheus reads the metrics (/metrics). Keep it private: never
# expose this port to the internet.
METRICS_PORT=9091

# The website's address: the only origin allowed to call the API (CORS),
# and the base of the unsubscribe link in emails.
FRONTEND_URL=http://localhost:3000

# Clerk's secret key (Clerk dashboard -> API Keys), the same application as
# web/.env.local's NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY. Required: the backend
# uses it to check sign-in tokens and to read and delete accounts.
CLERK_SECRET_KEY=

# Comma-separated emails of the accounts allowed into the admin pages.
ADMIN_EMAILS=

# Brevo, for real emails (free tier: Settings -> SMTP & API for the key;
# verify BREVO_FROM_EMAIL under Senders). Leave the key empty and emails are
# written to the log instead, which is what you want locally.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=WatchmyJob.co

# false runs the API alone, without the job sync and email timers.
SCHEDULING_ENABLED=true

# The pause between one sync round's end and the next one's start. Each
# round writes every company's "last checked" time and re-reads the boards
# that changed, out of the table's small free-tier capacity, which 5m fits
# comfortably.
SYNC_INTERVAL=5m

# Not set by you: Render sets RENDER_EXTERNAL_URL on its services, and the
# server then requests its own /health every 10 minutes so Render's free
# plan never stops it (a stopped service syncs nothing and sends nothing).

# For Grafana Cloud on the deployed site: a long random secret. When set, the
# public port also serves GET /metrics, but only to a caller sending it as
# "Authorization: Bearer <token>". Leave it empty locally (Prometheus reads
# METRICS_PORT instead).
METRICS_TOKEN=
