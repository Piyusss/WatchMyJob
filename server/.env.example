# Neon (or any hosted Postgres). Two URLs, both from the same database:
# DATABASE_URL is Neon's POOLED connection string (the one whose host starts
# with the same name but is routed through PgBouncer -- Neon's dashboard
# labels this "Pooled connection"), used by the running app so a burst of
# concurrent requests doesn't exhaust Neon's connection limit.
# DIRECT_DATABASE_URL is the UNPOOLED string ("Direct connection" in Neon's
# dashboard), used only by `prisma migrate`/`db push`: PgBouncer's
# transaction-pooling mode breaks the session-level lock a migration takes,
# which Neon's own docs call out for Prisma specifically.
# For local Docker Postgres (docker-compose.yml's `db` service) the two are
# identical, since there's no pooler in front of it.
DATABASE_URL="postgresql://jobdrop:jobdrop@localhost:5433/jobdrop"
DIRECT_DATABASE_URL="postgresql://jobdrop:jobdrop@localhost:5433/jobdrop"
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# Clerk (see auth/authenticate.ts) -- required, the API refuses to boot
# without both. Same application as web/.env.local.example's
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY; get both from the Clerk dashboard's
# API Keys page.
CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Admin/test-companies (see auth/authenticate.ts's requireAdmin and
# testCompanies/routes.ts). Comma-separated Clerk account emails allowed to
# reach /api/admin/* -- leave blank to lock the feature out for everyone
# even when ALLOW_TEST_COMPANIES is on.
ADMIN_EMAILS=""
# Section 17 of custom_company.txt: on by default outside production, off by
# default in it. Set explicitly ("true"/"false") to override either
# direction; leave blank to take the NODE_ENV-based default.
ALLOW_TEST_COMPANIES=""

# Email provider (see src/email/index.ts): Brevo if both vars are set,
# otherwise the console provider -- emails are printed to the log instead
# of sent, which is the intended default for local development.

# Brevo: free tier, no card, no domain needed -- verifies a single sender
# address instead. Get the API key from Brevo -> Settings -> SMTP & API,
# and verify BREVO_FROM_EMAIL under Senders, Domains & Dedicated IPs.
BREVO_API_KEY=""
BREVO_FROM_EMAIL=""
BREVO_FROM_NAME="WatchmyJob.co"
