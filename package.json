{
  "name": "jobdrop",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "test": "npm test -w server",
    "build:web": "npm run build -w web",
    "build:server": "npm run build -w server",
    "dev:server": "npm run dev -w server",
    "dev:worker": "npm run dev:worker -w server",
    "dev:notification-worker": "npm run dev:notification-worker -w server",
    "dev:web": "npm run dev -w web",
    "db:migrate": "npm run db:migrate -w server",
    "db:studio": "npm run db:studio -w server",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down"
  }
}
