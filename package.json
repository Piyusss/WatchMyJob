{
  "name": "jobdrop",
  "private": true,
  "workspaces": [
    "web"
  ],
  "scripts": {
    "test": "node scripts/server.mjs test",
    "build:web": "npm run build -w web",
    "build:server": "node scripts/server.mjs build",
    "dev:server": "node scripts/server.mjs dev",
    "dev:web": "npm run dev -w web",
    "db:up": "docker compose up -d dynamodb",
    "db:down": "docker compose down",
    "monitoring:up": "docker compose --profile monitoring up -d prometheus grafana",
    "monitoring:down": "docker compose --profile monitoring stop prometheus grafana"
  }
}
